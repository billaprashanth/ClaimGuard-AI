# Copy to .env and adjust. Every value is optional.
# Fraud score bands (0-100)
LOW_RISK_MAX=30
MEDIUM_RISK_MAX=65
# Score blending
RULE_WEIGHT=0.55
ML_WEIGHT=0.45
CRITICAL_FLOOR=70
# Business rules (IRDAI standard values)
INITIAL_WAITING_DAYS=30
PED_WAITING_MONTHS=36
# Workflow engine: langgraph (default) or builtin (zero-dependency engine, same graph)
CLAIMGUARD_ENGINE=langgraph
# Optional LLM case-note writer (disabled by default). Only Anthropic Claude is supported.
LLM_PROVIDER=none
# ANTHROPIC_API_KEY=your-key-here
# ANTHROPIC_MODEL=claude-sonnet-5-5
